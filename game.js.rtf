\f0\fs24 \cf0 let canvas = document.getElementById('gameCanvas');\
let ctx = canvas.getContext('2d');\
\
let score = 0;\
let currentAnswer = null;\
let enemyShips = [];\
let explosions = [];\
let gameOver = false;\
\
// Audio setup\
let cannonSound = new Audio('cannon.mp3');\
let explosionSound = new Audio('explosion.mp3');\
\
// Game loop\
function gameLoop() \{\
  if (gameOver) return;\
\
  ctx.clearRect(0, 0, canvas.width, canvas.height);\
  drawPlayerShip();\
  moveEnemyShips();\
  drawEnemyShips();\
  drawExplosions();\
  requestAnimationFrame(gameLoop);\
\}\
\
// Draw player ship\
function drawPlayerShip() \{\
  ctx.fillStyle = 'blue';\
  ctx.fillRect(canvas.width / 2 - 25, canvas.height - 60, 50, 50);\
\}\
\
// Enemy ship generator\
function createEnemyShip() \{\
  let x = Math.random() * (canvas.width - 50);\
  enemyShips.push(\{ x: x, y: 0, speed: 2 \});\
\}\
\
// Move enemy ships\
function moveEnemyShips() \{\
  for (let i = 0; i < enemyShips.length; i++) \{\
    enemyShips[i].y += enemyShips[i].speed;\
    if (enemyShips[i].y > canvas.height) \{\
      enemyShips.splice(i, 1);\
      i--;\
    \}\
  \}\
\}\
\
// Draw enemy ships\
function drawEnemyShips() \{\
  ctx.fillStyle = 'red';\
  for (let ship of enemyShips) \{\
    ctx.fillRect(ship.x, ship.y, 50, 50);\
  \}\
\}\
\
// Explosion animation\
function drawExplosions() \{\
  for (let i = 0; i < explosions.length; i++) \{\
    ctx.beginPath();\
    ctx.arc(explosions[i].x, explosions[i].y, explosions[i].radius, 0, Math.PI * 2);\
    ctx.fillStyle = 'orange';\
    ctx.fill();\
    explosions[i].radius += 2;\
    if (explosions[i].radius > 30) \{\
      explosions.splice(i, 1);\
      i--;\
    \}\
  \}\
\}\
\
// Generate a mixed number question\
function generateQuestion() \{\
  let whole1 = Math.floor(Math.random() * 3) + 1;\
  let num1 = Math.floor(Math.random() * 8) + 1;\
  let den1 = Math.floor(Math.random() * 8) + 2;\
\
  let whole2 = Math.floor(Math.random() * 3) + 1;\
  let num2 = Math.floor(Math.random() * 8) + 1;\
  let den2 = Math.floor(Math.random() * 8) + 2;\
\
  let operator = Math.random() > 0.5 ? '+' : '-';\
\
  document.getElementById('question').textContent = \
    `Solve: $\{whole1\} $\{num1\}/$\{den1\} $\{operator\} $\{whole2\} $\{num2\}/$\{den2\}`;\
\
  currentAnswer = calculateAnswer(\
    \{ whole: whole1, num: num1, den: den1 \},\
    \{ whole: whole2, num: num2, den: den2 \},\
    operator\
  );\
\
  createEnemyShip(); // Spawn enemy\
\}\
\
// Convert mixed to improper fraction\
function toImproperFrac(\{ whole, num, den \}) \{\
  return \{ num: whole * den + num, den \};\
\}\
\
// Greatest common divisor\
function gcd(a, b) \{\
  return b ? gcd(b, a % b) : a;\
\}\
\
// Simplify\
function simplify(n, d) \{\
  let g = gcd(n, d);\
  return \{ num: n / g, den: d / g \};\
\}\
\
// Back to mixed\
function toMixed(num, den) \{\
  return \{\
    whole: Math.floor(num / den),\
    num: num % den,\
    den: den\
  \};\
\}\
\
// Calculate answer\
function calculateAnswer(frac1, frac2, op) \{\
  let a = toImproperFrac(frac1);\
  let b = toImproperFrac(frac2);\
\
  let lcd = a.den * b.den;\
  let aNum = a.num * b.den;\
  let bNum = b.num * a.den;\
  let resultNum = op === '+' ? aNum + bNum : aNum - bNum;\
\
  let simplified = simplify(resultNum, lcd);\
  return toMixed(simplified.num, simplified.den);\
\}\
\
// Check answer\
function submitAnswer() \{\
  let input = document.getElementById('answer').value.trim();\
  let parts = input.split(' ');\
  let whole = parseInt(parts[0]) || 0;\
  let frac = parts[1] ? parts[1].split('/') : [0, 1];\
  let num = parseInt(frac[0]) || 0;\
  let den = parseInt(frac[1]) || 1;\
\
  let user = toImproperFrac(\{ whole, num, den \});\
  let correct = toImproperFrac(currentAnswer);\
\
  let lcd = user.den * correct.den;\
  let userNum = user.num * correct.den;\
  let correctNum = correct.num * user.den;\
\
  if (userNum === correctNum) \{\
    score++;\
    document.getElementById('feedback').textContent = "
\f1 \uc0\u9989 
\f0  Direct Hit!";\
    document.getElementById('score').textContent = score;\
    fireCannon();\
    explosionSound.play();\
  \} else \{\
    document.getElementById('feedback').textContent = \
      `
\f1 \uc0\u10060 
\f0  Wrong! Correct: $\{currentAnswer.whole\} $\{currentAnswer.num\}/$\{currentAnswer.den\}`;\
  \}\
\
  document.getElementById('answer').value = '';\
  generateQuestion();\
\}\
\
// Fire cannon animation\
function fireCannon() \{\
  cannonSound.play();\
  let enemy = enemyShips.shift();\
  if (enemy) \{\
    explosions.push(\{ x: enemy.x + 25, y: enemy.y + 25, radius: 5 \});\
  \}\
\}\
\
window.onload = () => \{\
  generateQuestion();\
  gameLoop();\
\};\
}